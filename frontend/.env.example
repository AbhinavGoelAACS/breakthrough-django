# BreakThrough Frontend Environment Configuration
# Copy this file to .env.local for development or .env.production for production
# NEVER commit .env files to version control!

# ===========================================
# API CONFIGURATION
# ===========================================
# Development
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Production (uncomment and modify for production)
# VITE_API_URL=https://api.yourdomain.com
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# ===========================================
# APPLICATION SETTINGS
# ===========================================
VITE_APP_NAME=BreakThrough
VITE_APP_VERSION=1.0.0

# ===========================================
# FEATURE FLAGS (optional)
# ===========================================
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# ===========================================
# EXTERNAL SERVICES (optional)
# ===========================================
# VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ===========================================
# NOTES
# ===========================================
# - All VITE_ prefixed variables are exposed to the client
# - Do NOT put sensitive data (API keys, secrets) here
# - These values are bundled into the build
