# BreakThrough Backend Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_NAME=breakthroughdb
DB_USER=your_database_user
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=3306

# ===========================================
# DJANGO SETTINGS
# ===========================================
# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-django-key-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET_KEY=your-jwt-secret-key-should-be-long-and-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# EMAIL CONFIGURATION (SMTP)
# ===========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourdomain.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=BreakThrough <noreply@yourdomain.com>

# ===========================================
# CROSSREF DOI REGISTRATION
# ===========================================
CROSSREF_USERNAME=your_crossref_username
CROSSREF_PASSWORD=your_crossref_password
CROSSREF_DOI_PREFIX=10.xxxxx
CROSSREF_DEPOSITOR_NAME=Your Organization Name
CROSSREF_DEPOSITOR_EMAIL=doi@yourdomain.com

# ===========================================
# FILE UPLOAD SETTINGS
# ===========================================
MEDIA_ROOT=/home/username/public_html/backend/media
STATIC_ROOT=/home/username/public_html/backend/staticfiles
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# ===========================================
# CORS SETTINGS
# ===========================================
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=True

# ===========================================
# CPANEL SPECIFIC
# ===========================================
# Path to Python executable in cPanel
# PYTHON_PATH=/home/username/virtualenv/backend/3.10/bin/python

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=/home/username/logs/breakthrough_backend.log
